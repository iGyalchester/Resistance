# Copy to backend.hcl (gitignored) and fill in the values from `terraform
# output` in bootstrap/. Then: terraform init -backend-config=backend.hcl
# CI writes this file itself from the TF_STATE_BUCKET repository variable.
bucket       = "resistance-tfstate-changeme"
key          = "dev/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
