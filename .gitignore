################################################################################

.metadata/
.project
.classpath
.settings/
.loadpath
.recommenders/

bin/
tmp/

*.tmp
*.bak
*.swp


################################################################################
# VISUAL STUDIO CODE
################################################################################

.vscode/
.history/
*.vsix


################################################################################
# CLAUDE CODE
################################################################################

.claude/
# CLAUDE.md is committed intentionally - project context for Claude sessions


################################################################################
# GENERIC BUILD & TEMP
################################################################################

build/
dist/

*.swp
*.swo
*.bak
*.tmp
*~.nib


################################################################################
# TERRAFORM (infrastructure/terraform)
################################################################################

# provider binaries and module cache; the lock file IS committed
**/.terraform/*
# TF_DATA_DIR=.terraform-<env>, so several environments can stay
# initialised side by side out of the single stack/ root
**/.terraform-*/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# may carry secrets - example files are tracked instead
*.auto.tfvars
secrets.tfvars

# backend config is account-specific - commit backend.hcl.example instead
backend.hcl
